# =============================================================================
# VectorHire Root Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Database & Authentication) — REQUIRED
# -----------------------------------------------------------------------------
# Public URL of your Supabase project (used by both Frontend and Backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Secret Key (REQUIRED for server-side NestJS backend API).
# NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-side Publishable / Anon Key (REQUIRED for Next.js frontend auth).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# 2. Redis & BullMQ Queue System — REQUIRED
# -----------------------------------------------------------------------------
# Redis connection URL (plain TCP redis:// or TLS rediss://).
# If REDIS_URL is provided, it takes precedence over REDIS_HOST/PORT.
# Development: redis://127.0.0.1:6379
# Production:  rediss://default:your-password@your-managed-redis.com:6379
REDIS_URL=redis://127.0.0.1:6379

# Host-based Redis connection fallback (used if REDIS_URL is unset)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# -----------------------------------------------------------------------------
# 3. Server Ports & Networking — OPTIONAL
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# 4. AI Providers (Fallback Chain) — OPTIONAL
# -----------------------------------------------------------------------------
# Active priority provider: gemini | grok | groq | openrouter | openai
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Grok / xAI (https://console.x.ai)
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 5. Email Notifications — OPTIONAL
# -----------------------------------------------------------------------------
# Gmail SMTP Credentials
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Demo mode override: redirects all outgoing candidate emails to a test inbox
DEMO_EMAIL_OVERRIDE=

# Resend API Key (if using Resend provider)
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# 6. GitHub Intelligence & Calendar Integration — OPTIONAL
# -----------------------------------------------------------------------------
# GitHub Personal Access Token (boosts rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
