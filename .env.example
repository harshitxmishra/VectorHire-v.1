# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gmail SMTP (assessment/interview/offer emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Calendar (optional — leave unset to skip real Calendar/Meet creation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# AI provider layer
# ---------------------------------------------------------------------------
# AI_PROVIDER picks which provider tries first. Leave unset and the default
# priority order is used: gemini -> grok -> groq -> openrouter -> openai.
# Only the provider(s) whose API key you set are actually usable; an unset
# key means that provider is skipped entirely (no error), it just won't be
# part of the fallback chain.
AI_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Grok / xAI (https://console.x.ai) — NOT the same as Groq below.
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Groq (https://console.groq.com/keys) — fast inference, hosts Llama/Mixtral
# etc. Key format is gsk_... — easy to confuse with Grok/xAI above, they are
# unrelated companies/APIs.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai/keys) — model can be any OpenRouter slug
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
