{
  "name": "vectorhire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "build:backend": "npm --prefix backend run build",
    "start": "next start",
    "test": "vitest run",
    "test:backend": "npm --prefix backend run test",
    "test:integration": "npm --prefix backend run test:integration",
    "test:all": "vitest run && npm --prefix backend run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fluentui/react-components": "^9.74.1",
    "@fluentui/react-icons": "^2.0.329",
    "@google/genai": "latest",
    "@supabase/supabase-js": "^2.108.2",
    "googleapis": "^173.0.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.1",
    "openai": "^6.45.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
